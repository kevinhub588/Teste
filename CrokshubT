local function melhorOvoV2()
    local ovos = listarOvosCache()
    if #ovos == 0 then return nil end
    if not States.ESPAreaAtual then return ovos[1] end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return ovos[1] end
    local areas = workspace:FindFirstChild("World")
    areas = areas and areas:FindFirstChild("Areas")
    areas = areas and areas:FindFirstChild("GuardAreas")
    if not areas then return ovos[1] end
    local areaAtual, menorDist = nil, math.huge
    for _, area in ipairs(areas:GetChildren()) do
        local ok, bb, size = pcall(function() return area:GetBoundingBox() end)
        if ok and bb and size then
            local p = bb:PointToObjectSpace(hrp.Position)
            if math.abs(p.X) <= size.X/2 and math.abs(p.Z) <= size.Z/2 then
                areaAtual = area.Name; break
            end
        end
        local piv = area:GetPivot().Position
        local d = (Vector3.new(piv.X,0,piv.Z) - Vector3.new(hrp.Position.X,0,hrp.Position.Z)).Magnitude
        if d < menorDist then menorDist = d; areaAtual = area.Name end
    end
    if not areaAtual then return ovos[1] end
    for _, o in ipairs(ovos) do if o.Area == areaAtual then return o end end
    return ovos[1]
end


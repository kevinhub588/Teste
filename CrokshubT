end

local function irMelhorOvoV2()
    if States.IrAtivo then
        pararIrV2()
        return false
    end
    States.IrAtivo = true
    speedForcando = true
    speedAlvo = 250

    irThread = task.spawn(function()
        local ovo = melhorOvoV2()
        if not ovo or not ovo.Pos then
            addLog("Nenhum ovo")
            pararIrV2()
            return
        end
        addLog("Indo: " .. ovo.Nome .. " [250]")
        cancelarMovimentoV2()
        task.wait(0.03)
        moverV2(ovo.Pos)
        local t0 = tick()
        local ultimoReenvio = 0
        local chegou = false
        while States.IrAtivo and (tick() - t0) < 30 do
            local _, h, hrp = getCharV2()
            if not hrp then break end
            local d = (hrp.Position - ovo.Pos).Magnitude
            if d <= 25 then
                chegou = true
                break
            end
            if tick() - ultimoReenvio > 0.4 then
                moverV2(ovo.Pos)
                ultimoReenvio = tick()
            end
            task.wait(0.08)
        end

        if chegou and States.IrAtivo then
            cancelarMovimentoV2()
            task.wait(0.15)
            tpInstaV2(ovo.Pos, 2)
            task.wait(0.2)

            local prompt = nil
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Name == "CarryAreaEgg" then
                    local p = d.Parent
                    if p and (p:IsA("BasePart") or p:IsA("Model")) then
                        local pp = p:IsA("BasePart") and p.Position or p:GetPivot().Position
                        if (pp - ovo.Pos).Magnitude < 15 then
                            prompt = d
                            break
                        end
                    end
                end
            end
            if prompt then
                pcall(function() prompt:InputHoldBegin() end)
                task.wait(0.05)
                pcall(function() prompt:InputHoldEnd() end)
                if fireproximityprompt then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            end
        end

        speedForcando = false
        local _, h = getCharV2()
        if h then h.WalkSpeed = States.SpeedPadrao end
        States.IrAtivo = false
        irThread = nil
        addLog("IR finalizado")
    end)
    return true
end


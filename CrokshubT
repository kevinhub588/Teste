local irThread = nil
local function pararIrV2()
    States.IrAtivo = false
    if irThread then
        pcall(function() task.cancel(irThread) end)
        irThread = nil
    end
    speedForcando = false
    cancelarMovimentoV2()
    local _, h = getCharV2()

-- ESP PLAYER
local espPlayerCache = {}

_G.CroksLimparESPPlayer = function()
    for uid, data in pairs(espPlayerCache) do
        if data.hl and data.hl.Parent then data.hl:Destroy() end
        if data.bb and data.bb.Parent then data.bb:Destroy() end
        if data.conn then pcall(function() data.conn:Disconnect() end) end
    end
    espPlayerCache = {}
end

local function criarEspPlayer(player)
    local c = player.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hl = Instance.new("Highlight")
    hl.Name = "CroksESPPlayerHL"
    hl.Adornee = c
    hl.FillColor = Color3.fromRGB(180, 180, 180)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0.1
    pcall(function() hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
    hl.Parent = c

    local bb = Instance.new("BillboardGui")
    bb.Name = "CroksESPPlayerTag"
    bb.Size = UDim2.new(0, 200, 0, 44)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = hrp
    bb.Parent = hrp

    local fr = Instance.new("Frame", bb)
    fr.Size = UDim2.new(1, 0, 1, 0)
    fr.BackgroundColor3 = Color3.fromRGB(20, 8, 8)
    fr.BackgroundTransparency = 0.15
    fr.BorderSizePixel = 0
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 6)
    local stk = Instance.new("UIStroke", fr)
    stk.Color = Color3.fromRGB(180, 180, 180)
    stk.Thickness = 1.5

    local nomeLbl = Instance.new("TextLabel", fr)
    nomeLbl.Size = UDim2.new(1, -8, 0, 18)
    nomeLbl.Position = UDim2.new(0, 4, 0, 2)
    nomeLbl.BackgroundTransparency = 1
    nomeLbl.Text = player.Name
    nomeLbl.TextColor3 = C.text
    nomeLbl.Font = Enum.Font.GothamBlack
    nomeLbl.TextSize = 12
    nomeLbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    nomeLbl.TextStrokeTransparency = 0.4

    local infoLbl = Instance.new("TextLabel", fr)
    infoLbl.Size = UDim2.new(1, -8, 0, 14)
    infoLbl.Position = UDim2.new(0, 4, 0, 22)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Text = ""
    infoLbl.TextColor3 = Color3.fromRGB(200, 200, 220)
    infoLbl.Font = Enum.Font.GothamBold
    infoLbl.TextSize = 10
    infoLbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    infoLbl.TextStrokeTransparency = 0.5

    local conn = player.CharacterAdded:Connect(function()
        task.wait(1)
        if States.ESPPlayerAtivo then
            local old = espPlayerCache[player.UserId]
            if old then
                if old.hl and old.hl.Parent then old.hl:Destroy() end
                if old.bb and old.bb.Parent then old.bb:Destroy() end
                if old.conn then pcall(function() old.conn:Disconnect() end) end
            end
            espPlayerCache[player.UserId] = nil
            criarEspPlayer(player)
        end
    end)

    espPlayerCache[player.UserId] = {hl=hl, bb=bb, fr=fr, stk=stk, nomeLbl=nomeLbl, infoLbl=infoLbl, conn=conn}
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if States.ESPPlayerAtivo then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and not espPlayerCache[p.UserId] then
                    criarEspPlayer(p)
                end
            end
            for uid, data in pairs(espPlayerCache) do
                local p = Players:GetPlayerByUserId(uid)
                if not p or not p.Character or not p.Character.Parent then
                    if data.hl and data.hl.Parent then data.hl:Destroy() end
                    if data.bb and data.bb.Parent then data.bb:Destroy() end
                    if data.conn then pcall(function() data.conn:Disconnect() end) end
                    espPlayerCache[uid] = nil
                end
            end
            local _, _, meuHrp = getCharV2()
            for uid, data in pairs(espPlayerCache) do
                local p = Players:GetPlayerByUserId(uid)
                if p and p.Character and data.hl and data.hl.Parent then
                    local temOvo = TaComOvo(p)
                    if temOvo then
                        local ovoInfo = nil
                        for _, t in ipairs(p.Character:GetChildren()) do
                            if t:IsA("Tool") then
                                local cat = t:GetAttribute("AssetCategory")
                                if cat then
                                    ovoInfo = getEggInfo(cat)
                                    if ovoInfo then break end
                                end
                            end
                        end
                        data.hl.FillColor = Color3.fromRGB(255, 140, 0)
                        data.hl.OutlineColor = Color3.fromRGB(255, 220, 60)
                        data.stk.Color = Color3.fromRGB(255, 180, 60)
                        data.nomeLbl.TextColor3 = Color3.fromRGB(255, 220, 120)
                        if ovoInfo then
                            data.infoLbl.Text = ovoInfo.Nome .. " | $" .. formatarValor(ovoInfo.Valor) .. "/s"
                            data.infoLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
                        else
                            data.infoLbl.Text = "COM OVO"
                            data.infoLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
                        end
                    else
                        data.hl.FillColor = Color3.fromRGB(180, 180, 180)
                        data.hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        data.stk.Color = Color3.fromRGB(180, 180, 180)
                        data.nomeLbl.TextColor3 = C.text
                        data.infoLbl.Text = "sem ovo"
                        data.infoLbl.TextColor3 = Color3.fromRGB(160, 160, 180)
                    end
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if meuHrp and hrp then
                        local d = math.floor((meuHrp.Position - hrp.Position).Magnitude)
                        data.infoLbl.Text = data.infoLbl.Text .. " | " .. d .. "m"
                    end
                end
            end
        else
            if next(espPlayerCache) then
                _G.CroksLimparESPPlayer()
            end
        end
    end
end)


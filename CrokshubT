local function corDaRaridade(rarName, corAsset)
    if type(rarName) == "string" and rarName ~= "" and rarName ~= "?" then
        local key = string.lower(tostring(rarName))
        if MAPA_RARIDADE[key] then return MAPA_RARIDADE[key] end
        for k, v in pairs(MAPA_RARIDADE) do
            if string.find(key, k, 1, true) then return v end
        end
    end
    if typeof(corAsset) == "Color3" then return corAsset end
    return COR_PADRAO_RARIDADE
end


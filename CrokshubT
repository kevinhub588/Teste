local Bypass = { Enabled=true, InProgress=false, CloneHumanoid=nil }
local PROPS_TO_COPY = {
    "WalkSpeed","JumpPower","JumpHeight","UseJumpPower","MaxHealth","Health",
    "AutoRotate","AutoJumpEnabled","BreakJointsOnDeath","CameraOffset",
    "DisplayDistanceType","HealthDisplayDistance","HealthDisplayType",
    "NameDisplayDistance","NameOcclusion","RequiresNeck","WalkJumpPower",
    "HipHeight","RigType","WalkSpeedCheck","EvaluateStateMachine","MaxSlopeAngle",
    "AutomaticScalingEnabled",
}
local STATE_ENUMS = {
    Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.GettingUp, Enum.HumanoidStateType.Landed,
    Enum.HumanoidStateType.Flying, Enum.HumanoidStateType.Freefall,
    Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.PlatformStanding,
    Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming,
    Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics,
    Enum.HumanoidStateType.StrafingNoPhysics, Enum.HumanoidStateType.Jumping,
}
local function bypassCopyProps(orig, clone)
    for _, prop in ipairs(PROPS_TO_COPY) do
        pcall(function()
            local ok, value = pcall(function() return orig[prop] end)
            if ok and value ~= nil then pcall(function() clone[prop] = value end) end
        end)
    end
end
local function bypassCaptureStates(hum)
    local states = {}
    for _, s in ipairs(STATE_ENUMS) do
        local ok, enabled = pcall(function() return hum:GetStateEnabled(s) end)
        if ok then states[s] = enabled end
    end
    local curState
    pcall(function() curState = hum:GetState() end)
    return states, curState
end
local function bypassReapplyStates(hum, states, curState)
    for s, enabled in pairs(states or {}) do
        pcall(function() hum:SetStateEnabled(s, enabled) end)
    end
    if curState then pcall(function() hum:ChangeState(curState) end) end
end

function Bypass.Apply(character)
    if not Bypass.Enabled or Bypass.InProgress then return false end
    Bypass.InProgress = true
    character = character or LocalPlayer.Character
    if not character then Bypass.InProgress = false return false end
    local origHum = character:FindFirstChildOfClass("Humanoid")
    if not origHum then Bypass.InProgress = false return false end
    local cloneHum
    if not pcall(function() cloneHum = origHum:Clone() end) or not cloneHum then
        Bypass.InProgress = false return false
    end
    local animator = origHum:FindFirstChildOfClass("Animator")
    local animatorMoved = false
    if animator then animatorMoved = pcall(function() animator.Parent = cloneHum end) end
    bypassCopyProps(origHum, cloneHum)
    local states, curState = bypassCaptureStates(origHum)
    pcall(function() cloneHum.Name = "Humanoid" end)
    if not pcall(function() cloneHum.Parent = character end) then
        if animatorMoved and animator and animator.Parent ~= origHum then
            pcall(function() animator.Parent = origHum end)
        end
        Bypass.InProgress = false return false
    end
    task.wait(0.05)
    pcall(function() origHum:Destroy() end)
    task.wait(0.05)
    pcall(function()
        if workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = cloneHum end
    end)
    bypassReapplyStates(cloneHum, states, curState)
    Bypass.CloneHumanoid = cloneHum
    Bypass.InProgress = false
    return true
end

function Bypass.Restore()
    local character = LocalPlayer.Character
    if not character then return false end
    local cloneHum = Bypass.CloneHumanoid
    if not cloneHum or not cloneHum.Parent then
        Bypass.CloneHumanoid = nil
        return false
    end
    local newHum = Instance.new("Humanoid")
    newHum.Name = "Humanoid"
    bypassCopyProps(cloneHum, newHum)
    local animator = cloneHum:FindFirstChildOfClass("Animator")
    local states, curState = bypassCaptureStates(cloneHum)
    local animatorMoved = false
    if animator then animatorMoved = pcall(function() animator.Parent = newHum end) end
    if not pcall(function() newHum.Parent = character end) then
        if animatorMoved and animator and animator.Parent ~= cloneHum then
            pcall(function() animator.Parent = cloneHum end)
        end
        pcall(function() newHum:Destroy() end)
        return false
    end
    task.wait(0.05)
    pcall(function() cloneHum:Destroy() end)
    task.wait(0.05)
    bypassReapplyStates(newHum, states, curState)
    pcall(function()
        if workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = newHum end
    end)
    Bypass.CloneHumanoid = nil
    return true
end

